<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_visit_reason_list" model="ir.ui.view">
        <field name="name">crm.visit.reason.list</field>
        <field name="model">crm.visit.reason</field>
        <field name="arch" type="xml">
            <list string="Visit Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="requires_explanation"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_crm_visit_reason" model="ir.actions.act_window">
        <field name="name">Visit Reasons</field>
        <field name="res_model">crm.visit.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
