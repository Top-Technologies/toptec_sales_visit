<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- 1. Visit Management Overall Analysis (crm.visit)                  -->
    <!-- ================================================================= -->

    <!-- Visit Pivot View: Team & Salesperson Breakdown with Cash, Credit, Total Sales, and No Sales -->
    <record id="view_crm_visit_pivot" model="ir.ui.view">
        <field name="name">crm.visit.pivot</field>
        <field name="model">crm.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits Analysis" sample="1">
                <field name="team_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="cash_sale_count" type="measure"/>
                <field name="credit_sale_count" type="measure"/>
                <field name="total_sales_count" type="measure"/>
                <field name="no_sale_count" type="measure"/>
                <field name="cash_sale_amount" type="measure"/>
                <field name="credit_sale_amount" type="measure"/>
                <field name="total_sales_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Visit Graph View: Visits and Sales by Team -->
    <record id="view_crm_visit_graph" model="ir.ui.view">
        <field name="name">crm.visit.graph</field>
        <field name="model">crm.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit Sales &amp; Outcomes by Team" type="bar" sample="1">
                <field name="team_id"/>
                <field name="total_sales_count" type="measure"/>
                <field name="total_sales_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Visit Analysis Action -->
    <record id="action_crm_visit_analysis" model="ir.actions.act_window">
        <field name="name">Visits Analysis</field>
        <field name="res_model">crm.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_team': 1, 'search_default_group_user': 1}</field>
    </record>

    <!-- ================================================================= -->
    <!-- 2. Visit Sales Breakdown Report (sale.order from visits)           -->
    <!-- Reports: Cash vs Credit counts & Credit/Cash amounts in Birr by Team -->
    <!-- ================================================================= -->

    <!-- Pivot View: Sales Team x Sale Type (Cash vs Credit) with Birr Amounts & Counts -->
    <record id="view_sale_order_visit_pivot" model="ir.ui.view">
        <field name="name">sale.order.visit.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Visit Sales Analysis (Cash &amp; Credit)" sample="1">
                <field name="team_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="sale_type" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View: Team Sales Breakdown (Cash vs Credit in Birr) -->
    <record id="view_sale_order_visit_graph" model="ir.ui.view">
        <field name="name">sale.order.visit.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Visit Sales Breakdown by Team" type="bar" sample="1">
                <field name="team_id"/>
                <field name="sale_type"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dedicated Reporting Action for Sales Orders from Visits -->
    <record id="action_crm_visit_sales_breakdown" model="ir.actions.act_window">
        <field name="name">Visit Sales (Cash &amp; Credit)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('visit_id', '!=', False)]</field>
        <field name="context">{'search_default_group_team': 1, 'search_default_group_sale_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visit sales records found!
            </p>
            <p>
                Sales orders and quotations generated from customer visits will appear here, classified as Cash or Credit with counts and amounts in Birr.
            </p>
        </field>
    </record>

    <record id="action_crm_visit_sales_breakdown_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_sale_order_visit_pivot"/>
        <field name="act_window_id" ref="action_crm_visit_sales_breakdown"/>
    </record>

    <record id="action_crm_visit_sales_breakdown_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_sale_order_visit_graph"/>
        <field name="act_window_id" ref="action_crm_visit_sales_breakdown"/>
    </record>
</odoo>
